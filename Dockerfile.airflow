# Estende a imagem oficial do Airflow, adicionando as mesmas dependências
# que o pipeline já usa (duckdb, pandas, minio, etc.), para que as DAGs
# consigam importar diretamente os módulos em src/ (ingest, process, aggregate).
FROM apache/airflow:2.10.3-python3.11

COPY requirements.txt /opt/airflow/requirements.txt
RUN pip install --no-cache-dir -r /opt/airflow/requirements.txt
